# Prober agent — explores, asks, surfaces assumptions.
#
# In P1.3 this file gains: persona, dissent_dimensions,
# forbidden_behaviors, speaking_triggers, output_schema, cooldown_seconds.
# P1.1 freezes only the `llm_config` block.

llm_config:
  default_model: claude_code_sonnet_46
  fallback_chain:
    - deepseek_v4_flash
  temperature: 0.5
  required_capabilities: []

# PLACEHOLDER thresholds (not tuned; P1.5+ usage-based tuning).
# See ADR-005 Decision 3.
autonomy_thresholds:
  threshold_auto: 8
  threshold_confirm: 5
  user_intent_modifier: 2
