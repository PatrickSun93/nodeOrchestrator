# Operator — calls tools, fetches data, executes concrete actions.
#
# CANNOT use claude_code_* models: those go through the Claude Code
# CLI which does not accept orchestrator tool definitions
# (see ADR-003). `required_capabilities: [tools]` is what enforces
# this at config-validation time.
#
# Defaults to DeepSeek Flash for speed/cost on tool calls. Falls
# back to local MLX (Qwen 2.5 30B) when DeepSeek is unreachable —
# slower but keeps the operator working offline.

llm_config:
  default_model: deepseek_v4_flash
  fallback_chain:
    - qwen_mlx_30b
  temperature: 0.3
  required_capabilities:
    - tools

# PLACEHOLDER thresholds (not tuned; P1.5+ usage-based tuning).
# See ADR-005 Decision 3.
autonomy_thresholds:
  threshold_auto: 6
  threshold_confirm: 3
  user_intent_modifier: 3
