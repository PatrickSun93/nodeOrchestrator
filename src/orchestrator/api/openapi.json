  "components": {
    "schemas": {
      "ConfirmError": {
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "append",
              "execute"
            ],
            "title": "Stage"
          },
          "appended_event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Appended Event Id"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stage",
          "reason"
        ],
        "title": "ConfirmError",
        "description": "Partial-confirm error envelope (ADR-030 D5, mirrors IntentError).\n\nstage='append': nothing persisted \u2014 safe to refresh-and-retry.\nstage='execute': TOOL_CALL appended \u2014 do NOT re-confirm; reconcile via replay.\nreason: 'already_resolved' | 'room_closed' | 'not_found' | <executor error>"
      },
      "ConfirmRequest": {
        "properties": {
          "pending_event_id": {
            "type": "string",
            "title": "Pending Event Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "cancel"
            ],
            "title": "Decision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pending_event_id",
          "decision"
        ],
        "title": "ConfirmRequest",
        "description": "Client-to-server confirm/cancel of a pending gated tool call (ADR-030 D3).\n\nOnly pending_event_id + decision are accepted \u2014 extra=\"forbid\" makes it\ntype-impossible to smuggle tool_name/params/author (forge guard at schema layer,\nmirroring IntentRequest ADR-025 D4)."
      },
      "ConfirmResponse": {
        "properties": {
          "appended_event": {
            "$ref": "#/components/schemas/Event"
          },
          "turn_events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "title": "Turn Events"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "appended_event",
          "turn_events"
        ],
        "title": "ConfirmResponse",
        "description": "Successful confirm result: the appended TOOL_CALL or TOOL_CALL_CANCELLED + turn events."
      },
      "DecisionRef": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id"
        ],
        "title": "DecisionRef"
      },
      "Event": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "room_id": {
            "type": "string",
            "title": "Room Id"
          },
          "type": {
            "$ref": "#/components/schemas/EventType"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "timestamp": {
            "type": "integer",
            "title": "Timestamp"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "room_id",
          "type",
          "author",
          "timestamp",
          "content"
        ],
        "title": "Event",
        "description": "An immutable event in the append-only event log.\n\n`metadata` is `dict[str, Any]` for storage flexibility; per-type\nschema validation happens via `validate_metadata()` at append time.\nApplication-layer `frozen=True` plus the schema-level UPDATE/DELETE\ntriggers give overlapping append-only enforcement (see event-model.md\n\u00a7\"Append-only enforcement\")."
      },
      "EventType": {
        "type": "string",
        "enum": [
          "user_input",
          "utterance",
          "hypothesis",
          "decision",
          "rejection",
          "retraction",
          "observation",
          "tool_call",
          "tool_result",
          "tool_failed",
          "escalation",
          "summary_snapshot",
          "state_transition",
          "milestone",
          "term_definition",
          "decision_pivot",
          "autonomy_decision",
          "autonomy_refusal",
          "external_validation",
          "tool_call_pending",
          "tool_call_cancelled"
        ],
        "title": "EventType",
        "description": "The constitutional event types (ADR-030 adds TOOL_CALL_PENDING + TOOL_CALL_CANCELLED).\n\nSee docs/architecture/event-model.md for why this list is constitutional\nand what to do (and not do) when extending it. In short: adding a type\nrequires an ADR; renaming or merging types is a breaking change; a\n`generic_message` catch-all is forbidden."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HypothesisRef": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id"
        ],
        "title": "HypothesisRef"
      },
      "IntentError": {
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "append",
              "turn"
            ],
            "title": "Stage"
          },
          "appended_event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Appended Event Id"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stage",
          "reason"
        ],
        "title": "IntentError",
        "description": "Partial-turn error envelope (ADR-025 D5, R0-B Y3).\n\nstage=\"append\": nothing persisted \u2014 safe to retry.\nstage=\"turn\":  intent persisted \u2014 do NOT re-post; reconcile via replay."
      },
      "IntentRequest": {
        "properties": {
          "type": {
            "$ref": "#/components/schemas/EventType"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "content"
        ],
        "title": "IntentRequest",
        "description": "Client intent to append a user event and drive a turn (ADR-025 D4).\n\nNo author/id/timestamp fields \u2014 server stamps all three. extra=\"forbid\"\nrejects any unknown field at parse time (forge guard at schema layer).\ntype must be in INTENT_TYPE_ALLOWLIST; validated at the endpoint."
      },
      "IntentResponse": {
        "properties": {
          "appended_event": {
            "$ref": "#/components/schemas/Event"
          },
          "turn": {
            "$ref": "#/components/schemas/TurnResult"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "appended_event",
          "turn"
        ],
        "title": "IntentResponse",
        "description": "Successful intent result: the appended user event + turn result."
      },
      "Room": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "type": {
            "$ref": "#/components/schemas/RoomType"
          },
          "state": {
            "type": "string",
            "title": "State",
            "default": "open"
          },
          "created_at": {
            "type": "integer",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "title": "Room",
        "description": "A container for events.\n\nAppend-only at the application layer (the EventStore API does not\nexpose update/delete for rooms either), but the schema does not\nenforce this with TRIGGERs. Room state changes flow through\n`state_transition` events and can be derived on demand rather than\nmutating the rooms row."
      },
      "RoomType": {
        "type": "string",
        "enum": [
          "free_chat",
          "bug_fix",
          "research",
          "code_review",
          "idea_validation"
        ],
        "title": "RoomType",
        "description": "Room templates. State machine and default agent/tool sets vary by\ntype; those wirings come in P1."
      },
      "Snapshot": {
        "properties": {
          "room_id": {
            "type": "string",
            "title": "Room Id"
          },
          "room_type": {
            "$ref": "#/components/schemas/RoomType"
          },
          "room_state": {
            "type": "string",
            "title": "Room State"
          },
          "snapshot_at": {
            "type": "integer",
            "title": "Snapshot At"
          },
          "event_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Event Count"
          },
          "decision_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Decision Count"
          },
          "open_hypotheses": {
            "items": {
              "$ref": "#/components/schemas/HypothesisRef"
            },
            "type": "array",
