# Repo-wide line-ending policy.
#
# All text files use LF in repo AND in working tree, on every OS.
# This overrides any local `core.autocrlf` setting. See:
# https://git-scm.com/docs/gitattributes#_text
#
# Source incident: P1.6 cycle surfaced 174 files in CRLF/LF limbo
# from Windows-side tools converting LF → CRLF on a shared WSL/Windows
# working tree. Constitutional test
# `tests/test_constitution_line_endings.py` enforces this at test
# time.

# Default: auto-detect text/binary; text → LF.
* text=auto eol=lf

# Explicit text (no auto-detection needed).
*.py     text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.sh     text eol=lf
*.json   text eol=lf
*.lock   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Windows-specific scripts must keep CRLF (cmd.exe + PowerShell).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary (never normalize).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.exe  binary
*.dll  binary
*.so   binary
*.dylib binary
*.db   binary
*.sqlite  binary
*.sqlite3 binary
