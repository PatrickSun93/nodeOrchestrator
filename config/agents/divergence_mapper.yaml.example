# Divergence mapper — maps disagreements; never synthesizes.
#
# Output_schema (added P1.3) will forbid a `synthesis` field; this
# agent is the explicit refusal of "let's just average the
# perspectives" (handoff.md Principle 6).

llm_config:
  default_model: claude_code_sonnet_46
  fallback_chain:
    - deepseek_v4_flash
  temperature: 0.4
  required_capabilities: []

# PLACEHOLDER thresholds (not tuned; P1.5+ usage-based tuning).
# See ADR-005 Decision 3.
autonomy_thresholds:
  threshold_auto: 8
  threshold_confirm: 5
  user_intent_modifier: 2
