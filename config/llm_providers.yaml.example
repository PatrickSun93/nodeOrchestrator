# Example llm_providers.yaml. Copy to config/llm_providers.yaml and
# adapt to your environment.
#
# Each entry under `providers` is one physical provider connection.
# `id` is referenced by llm_models.yaml's `provider` field.
#
# Provider types:
#   openai_compatible  — DeepSeek, Ollama, MLX, anything OpenAI-API-shaped
#   claude_code_cli    — Anthropic models via Claude Code CLI subprocess
#                        (uses Max subscription quota; see ADR-003 for
#                        capability constraints — cannot accept
#                        orchestrator tool definitions)
#   agy_cli            — Google/Gemini models via the Antigravity (agy) CLI
#                        subprocess; cannot accept orchestrator tool definitions
#                        (same structural constraint as claude_code_cli)
#   mock               — test-only, deterministic responses

providers:
  # Anthropic models routed through the Claude Code CLI.
  # Requires `npm install -g @anthropic/claude-code` and a logged-in
  # Max subscription. See ADR-003.
  anthropic_via_claude_code:
    type: claude_code_cli
    params:
      cli_path: claude          # absolute path or PATH-resolved
      timeout_s: 600            # generous for xhigh effort
      # Alt-backend support (ADR-023 D4-D5): base_url redirects
      # ANTHROPIC_BASE_URL in the subprocess.  MUST be in
      # trusted_base_urls (fail-closed allowlist checked at startup).
      # Omit both fields to use the default Anthropic endpoint.
      # base_url: "https://my-trusted-proxy.internal/v1"
      # trusted_base_urls:
      #   - "https://my-trusted-proxy.internal/v1"

  # Google/Gemini models routed through the Antigravity CLI.
  # Requires `pip install agy` (or equivalent) and a logged-in Google account.
  # Note: agy honors AGY_BASE_URL for alt-backend routing; the allowlist
  # below enforces the same fail-closed pattern as claude_code_cli.
  google_via_agy:
    type: agy_cli
    params:
      cli_path: agy             # absolute path or PATH-resolved
      timeout_s: 600
      # Alt-backend support: base_url redirects AGY_BASE_URL in the
      # subprocess.  MUST be in trusted_base_urls (fail-closed allowlist).
      # Omit both fields to use the default Google/Gemini endpoint.
      # base_url: "https://my-trusted-proxy.internal/v1"
      # trusted_base_urls:
      #   - "https://my-trusted-proxy.internal/v1"

  # DeepSeek hosted API (OpenAI-compatible).
  deepseek:
    type: openai_compatible
    params:
      base_url: https://api.deepseek.com/v1
      api_key_env: DEEPSEEK_API_KEY
      timeout_s: 60

  # Local Ollama. Empty api_key_env => no auth header.
  ollama_local:
    type: openai_compatible
    params:
      base_url: http://localhost:11434/v1
      api_key_env: ""
      timeout_s: 120            # local can be slow on first model load

  # Local MLX (Apple Silicon). Same shape as Ollama.
  mlx_local:
    type: openai_compatible
    params:
      base_url: http://localhost:8080/v1
      api_key_env: ""
      timeout_s: 120

  # Test-only. Production configs should NOT include this entry.
  mock:
    type: mock
    params: {}
